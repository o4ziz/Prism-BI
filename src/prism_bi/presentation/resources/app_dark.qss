/* Prism BI — Dark theme */

* {
    font-family: "Segoe UI", "Segoe UI Variable", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

QMainWindow#PrismMainWindow {
    background: #0B1220;
}

QMenuBar {
    background: #111827;
    border-bottom: 1px solid #1F2937;
    padding: 2px 8px;
    color: #E5E7EB;
}

QMenuBar::item:selected {
    background: #1F2937;
    border-radius: 4px;
}

QMenu {
    background: #111827;
    border: 1px solid #1F2937;
    border-radius: 8px;
    padding: 6px;
    color: #E5E7EB;
}

QMenu::item:selected {
    background: #134E4A;
    color: #99F6E4;
}

QFrame#NavRail {
    background: #030712;
    border: none;
}

QLabel#NavBrand {
    color: #F9FAFB;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.4px;
    padding-left: 4px;
}

QPushButton#NavCollapseButton {
    background: transparent;
    border: none;
    border-radius: 6px;
}

QPushButton#NavCollapseButton:hover {
    background: #1F2937;
}

QListWidget#ActivityBar {
    background: transparent;
    color: #9CA3AF;
    border: none;
    outline: none;
}

QListWidget#ActivityBar::item {
    padding: 10px 10px;
    margin: 2px 0;
    border-radius: 8px;
    color: #9CA3AF;
}

QListWidget#ActivityBar::item:selected {
    background: #134E4A;
    color: #F0FDFA;
    border-left: 3px solid #2DD4BF;
}

QListWidget#ActivityBar::item:hover:!selected {
    background: #111827;
}

QToolBar#MainToolBar {
    background: #111827;
    border-bottom: 1px solid #1F2937;
    spacing: 8px;
    padding: 6px 12px;
    color: #E5E7EB;
}

QStatusBar {
    background: #111827;
    border-top: 1px solid #1F2937;
    color: #9CA3AF;
}

QStatusBar QLabel#StatusProject {
    color: #5EEAD4;
    font-weight: 600;
    padding-right: 12px;
}

QDockWidget {
    color: #E5E7EB;
}

QDockWidget::title {
    background: #111827;
    padding: 6px 10px;
    border-bottom: 1px solid #1F2937;
    font-weight: 600;
}

QPushButton {
    padding: 7px 14px;
    border: 1px solid #374151;
    border-radius: 8px;
    background: #1F2937;
    color: #E5E7EB;
}

QPushButton:hover {
    background: #374151;
}

QPushButton#PrimaryButton {
    background: #0D9488;
    border: 1px solid #0D9488;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton#PrimaryButton:hover {
    background: #14B8A6;
}

QPushButton#GhostButton {
    background: transparent;
    border: 1px solid transparent;
    color: #5EEAD4;
}

QPushButton:focus, QLineEdit:focus, QComboBox:focus, QListWidget:focus, QTableView:focus {
    border: 2px solid #2DD4BF;
    outline: none;
}

QLineEdit, QComboBox, QTextEdit, QSpinBox, QPlainTextEdit {
    padding: 6px 10px;
    border: 1px solid #374151;
    border-radius: 8px;
    background: #111827;
    color: #E5E7EB;
    selection-background-color: #134E4A;
    selection-color: #F0FDFA;
}

QComboBox {
    color: #E5E7EB;
    background-color: #111827;
    combobox-popup: 0;
}

QComboBox:!editable,
QComboBox:!editable:on {
    color: #E5E7EB;
    background-color: #111827;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
    background: transparent;
}

QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #111827;
    color: #E5E7EB;
    border: 1px solid #374151;
    selection-background-color: #134E4A;
    selection-color: #F0FDFA;
    outline: 0;
    padding: 4px;
}

QLabel {
    color: #E5E7EB;
}

QLabel#PageTitle {
    font-size: 22px;
    font-weight: 700;
    color: #F9FAFB;
}

QLabel#PageSubtitle {
    font-size: 13px;
    color: #9CA3AF;
}

QLabel#CardTitle {
    font-size: 14px;
    font-weight: 650;
    color: #F9FAFB;
}

QLabel#CardBody {
    font-size: 12px;
    color: #9CA3AF;
}

QLabel#SectionTitle {
    font-size: 12px;
    font-weight: 650;
    color: #9CA3AF;
    letter-spacing: 0.6px;
}

QLabel#EmptyStateGlyph {
    font-size: 36px;
    color: #2DD4BF;
}

QLabel#EmptyStateTitle {
    font-size: 16px;
    font-weight: 650;
    color: #F9FAFB;
}

QLabel#EmptyStateLabel {
    color: #9CA3AF;
    padding: 4px;
    font-size: 13px;
}

QFrame#ActionCard, QFrame#ContentPanel {
    background: #111827;
    border: 1px solid #1F2937;
    border-radius: 12px;
}

QFrame#ActionCard:hover {
    border-color: #134E4A;
}

QWidget#HomeView, QWidget#ModulePage {
    background: #0B1220;
}

QTableView#DataGrid, QTableView {
    gridline-color: #1F2937;
    background: #111827;
    alternate-background-color: #0F172A;
    border: 1px solid #1F2937;
    border-radius: 8px;
    selection-background-color: #134E4A;
    selection-color: #F0FDFA;
    color: #E5E7EB;
}

QHeaderView::section {
    background: #0F172A;
    color: #9CA3AF;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid #1F2937;
    font-weight: 600;
}

QListWidget {
    background: #111827;
    border: 1px solid #1F2937;
    border-radius: 8px;
    padding: 4px;
    color: #E5E7EB;
}

QListWidget::item {
    padding: 8px 10px;
    border-radius: 6px;
}

QListWidget::item:selected {
    background: #134E4A;
    color: #F0FDFA;
}

QListWidget::item:hover:!selected {
    background: #1F2937;
}

QSplitter::handle {
    background: #1F2937;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #374151;
    border-radius: 5px;
    min-height: 24px;
}
