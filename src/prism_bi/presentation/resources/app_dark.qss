/* Prism BI — Dark theme (near-black + single orange accent) */

* {
    font-family: "Segoe UI", "Inter", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

QMainWindow#PrismMainWindow {
    background: #0A0A0B;
}

QMenuBar {
    background: #16171A;
    border-bottom: 1px solid #26272B;
    padding: 2px 8px;
    color: #F5F5F5;
}

QMenuBar::item:selected {
    background: #1C1D21;
    border-radius: 4px;
}

QMenu {
    background: #16171A;
    border: 1px solid #26272B;
    border-radius: 11px;
    padding: 6px;
    color: #F5F5F5;
}

QMenu::item:selected {
    background: #1C1D21;
    color: #F5601A;
}

QFrame#NavRail {
    background: #0A0A0B;
    border: none;
    border-right: 1px solid #26272B;
}

QLabel#NavBrand {
    color: #F5F5F5;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.4px;
    padding-left: 4px;
}

QPushButton#NavCollapseButton {
    background: transparent;
    border: none;
    border-radius: 6px;
}

QPushButton#NavCollapseButton:hover {
    background: #1C1D21;
}

QListWidget#ActivityBar {
    background: transparent;
    color: #8A8F98;
    border: none;
    outline: none;
}

QListWidget#ActivityBar::item {
    padding: 10px 10px;
    margin: 2px 0;
    border-radius: 8px;
    color: #8A8F98;
    border-bottom: 2px solid transparent;
}

QListWidget#ActivityBar::item:selected {
    background: #16171A;
    color: #F5F5F5;
    border-bottom: 2px solid #F5601A;
}

QListWidget#ActivityBar::item:hover:!selected {
    background: #16171A;
    color: #F5F5F5;
}

QToolBar#MainToolBar {
    background: #16171A;
    border-bottom: 1px solid #26272B;
    spacing: 8px;
    padding: 6px 12px;
    color: #F5F5F5;
}

QStatusBar {
    background: #16171A;
    border-top: 1px solid #26272B;
    color: #8A8F98;
}

QStatusBar QLabel#StatusProject {
    color: #F5601A;
    font-weight: 600;
    padding-right: 12px;
}

QDockWidget {
    color: #F5F5F5;
}

QDockWidget::title {
    background: #16171A;
    padding: 6px 10px;
    border-bottom: 1px solid #26272B;
    font-weight: 600;
}

QPushButton {
    padding: 7px 14px;
    border: 1px solid #26272B;
    border-radius: 8px;
    background: #1C1D21;
    color: #F5F5F5;
}

QPushButton:hover {
    background: #26272B;
    border-color: #3A3B40;
}

QPushButton#PrimaryButton {
    background: #F5601A;
    border: 1px solid #F5601A;
    color: #0A0A0B;
    font-weight: 600;
}

QPushButton#PrimaryButton:hover {
    background: #FF8A3D;
    border-color: #FF8A3D;
}

QPushButton#GhostButton {
    background: transparent;
    border: 1px solid transparent;
    color: #F5601A;
}

QPushButton:focus, QLineEdit:focus, QComboBox:focus, QListWidget:focus, QTableView:focus {
    border: 2px solid #F5601A;
    outline: none;
}

QLineEdit, QComboBox, QTextEdit, QSpinBox, QPlainTextEdit {
    padding: 6px 10px;
    border: 1px solid #26272B;
    border-radius: 8px;
    background: #16171A;
    color: #F5F5F5;
    selection-background-color: #F5601A;
    selection-color: #0A0A0B;
}

QComboBox {
    color: #F5F5F5;
    background-color: #16171A;
    combobox-popup: 0;
}

QComboBox:!editable,
QComboBox:!editable:on {
    color: #F5F5F5;
    background-color: #16171A;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
    background: transparent;
}

QComboBox QAbstractItemView {
    background-color: #16171A;
    color: #F5F5F5;
    border: 1px solid #26272B;
    selection-background-color: #F5601A;
    selection-color: #0A0A0B;
    outline: 0;
    padding: 4px;
}

QLabel {
    color: #F5F5F5;
}

QLabel#PageTitle {
    font-size: 22px;
    font-weight: 700;
    color: #F5F5F5;
}

QLabel#PageSubtitle {
    font-size: 13px;
    color: #8A8F98;
}

QLabel#CardTitle {
    font-size: 14px;
    font-weight: 650;
    color: #F5F5F5;
}

QLabel#CardBody {
    font-size: 12px;
    color: #8A8F98;
}

QLabel#SectionTitle {
    font-size: 11px;
    font-weight: 650;
    color: #8A8F98;
    letter-spacing: 1.2px;
    text-transform: uppercase;
}

QLabel#EmptyStateGlyph {
    font-size: 36px;
    color: #F5601A;
}

QLabel#EmptyStateTitle {
    font-size: 16px;
    font-weight: 650;
    color: #F5F5F5;
}

QLabel#EmptyStateLabel {
    color: #8A8F98;
    padding: 4px;
    font-size: 13px;
}

QToolBar#VisualizeToolBar {
    background: #16171A;
    border: 1px solid #26272B;
    border-radius: 11px;
    margin: 0 0 8px 0;
    padding: 4px 8px;
    spacing: 4px;
    color: #F5F5F5;
}

QFrame#ChartPreviewPanel {
    background: #16171A;
    border: 1px solid #26272B;
    border-radius: 11px;
}

QToolButton#SectionToggle {
    background: transparent;
    border: none;
    color: #F5F5F5;
    font-weight: 650;
    padding: 8px 4px;
    text-align: left;
}

QFrame#CollapsibleSection {
    background: #16171A;
    border: 1px solid #26272B;
    border-radius: 11px;
}

QChartView#PrismChartView {
    background: #0A0A0B;
    border: 1px solid #26272B;
    border-radius: 11px;
}

QWidget#ChartHostWidget {
    background: #0A0A0B;
}

QFrame#ActionCard, QFrame#ContentPanel {
    background: #16171A;
    border: 1px solid #26272B;
    border-radius: 11px;
    padding: 4px;
}

QFrame#ActionCard:hover {
    border-color: #F5601A;
}

QWidget#HomeView, QWidget#ModulePage {
    background: #0A0A0B;
}

QTableView#DataGrid, QTableView, QTableWidget#DataGrid {
    gridline-color: #26272B;
    background: #16171A;
    alternate-background-color: #1C1D21;
    border: 1px solid #26272B;
    border-radius: 11px;
    selection-background-color: #F5601A;
    selection-color: #0A0A0B;
    color: #F5F5F5;
}

QHeaderView::section {
    background: #1C1D21;
    color: #8A8F98;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid #26272B;
    font-weight: 600;
    letter-spacing: 0.6px;
}

QListWidget {
    background: #16171A;
    border: 1px solid #26272B;
    border-radius: 11px;
    padding: 4px;
    color: #F5F5F5;
}

QListWidget::item {
    padding: 8px 10px;
    border-radius: 6px;
}

QListWidget::item:selected {
    background: #1C1D21;
    color: #F5F5F5;
    border-left: 2px solid #F5601A;
}

QListWidget::item:hover:!selected {
    background: #1C1D21;
}

QListWidget#ChartLibraryList::item:selected {
    background: #1C1D21;
    border-left: 2px solid #F5601A;
}

QSplitter::handle {
    background: #26272B;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #26272B;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #F5601A;
}
